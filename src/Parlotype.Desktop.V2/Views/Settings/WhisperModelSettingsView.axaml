<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.V2.ViewModels"
             xmlns:vms="using:Parlotype.Desktop.V2.ViewModels.Settings"
             x:Class="Parlotype.Desktop.V2.Views.Settings.WhisperModelSettingsView"
             x:DataType="vms:WhisperModelSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="12">
        <TextBlock Text="Whisper Model" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Larger models are more accurate but use more disk and CPU/GPU."
                   Opacity="0.7" />

        <ItemsControl ItemsSource="{Binding ModelOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WhisperModelDisplayItem">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            Padding="12,8"
                            Margin="0,2"
                            Command="{Binding SelectCommand}"
                            CommandParameter="{Binding Type}">
                        <Grid ColumnDefinitions="11,*,Auto,Auto">
                            <Border Grid.Column="0"
                                    Width="3" Height="16" CornerRadius="1.5"
                                    Background="{DynamicResource SystemAccentColor}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding IsSelected}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DiskSize}"
                                       FontSize="13" Opacity="0.5"
                                       VerticalAlignment="Center"
                                       Margin="24,0,0,0" />
                            <TextBlock Grid.Column="3"
                                       Text="(not downloaded)"
                                       FontSize="12"
                                       Opacity="0.5"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       IsVisible="{Binding !IsCached}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
