<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Parlotype.WinUI.Views.AudioSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:audio="using:Parlotype.Core.Audio"
    xmlns:vm="using:Parlotype.WinUI.ViewModels"
    xmlns:helpers="using:Parlotype.WinUI.Helpers">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="24" MaxWidth="700"
                    HorizontalAlignment="Left">

            <!-- ── Microphone Section ────────────────────────────── -->
            <StackPanel Spacing="8">
                <TextBlock Text="Microphone"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Select the microphone to use for voice input."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <ListView ItemsSource="{x:Bind ViewModel.AvailableMicrophones, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                          SelectionMode="Single"
                          Margin="0,8,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="audio:MicrophoneInfo">
                            <Grid ColumnSpacing="12" Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE720;"
                                          FontSize="20"
                                          VerticalAlignment="Center"
                                          Grid.Column="0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Default device"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               Visibility="{x:Bind IsDefault, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- ── Wait Time Section ─────────────────────────────── -->
            <StackPanel Spacing="8">
                <TextBlock Text="Silence Timeout"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="How long to wait after silence before ending a recording segment."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <ComboBox ItemsSource="{x:Bind vm:AudioSettingsViewModel.WaitTimeItems}"
                          SelectedItem="{x:Bind ViewModel.SelectedWaitTimeItem, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          MaxWidth="300"
                          Margin="0,8,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:WaitTimeItem">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</Page>
