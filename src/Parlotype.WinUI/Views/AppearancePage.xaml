<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Parlotype.WinUI.Views.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Parlotype.WinUI.ViewModels">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24">

            <TextBlock Text="Appearance"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <TextBlock Text="Customize the look and feel of Parlotype"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ListView x:Name="ThemeList"
                      SelectionMode="Single"
                      SelectionChanged="ThemeList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeItem">
                        <Grid Padding="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      FontSize="24"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Description}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>

</Page>
