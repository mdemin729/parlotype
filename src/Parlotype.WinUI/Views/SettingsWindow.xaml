<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Parlotype.WinUI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Parlotype.WinUI.Views"
    Title="Parlotype Settings">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="200"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Audio" Tag="audio">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE720;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Speech Model" Tag="speechmodel">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8C1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Hotkeys" Tag="hotkeys">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE765;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Appearance" Tag="appearance">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />

    </NavigationView>

</Window>
