<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Parlotype.WinUI.Views.SpeechModelPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Parlotype.WinUI.ViewModels"
    xmlns:local="using:Parlotype.WinUI.Views">

    <Page.Resources>
        <x:Double x:Key="CardMaxWidth">600</x:Double>
        <local:CacheStatusToGlyphConverter x:Key="CacheGlyphConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24" MaxWidth="{StaticResource CardMaxWidth}"
                    HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Speech Model"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <TextBlock Text="Select the Whisper model for speech recognition. Larger models are more accurate but slower."
                       TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Model list -->
            <ListView ItemsSource="{x:Bind ViewModel.ModelOptions}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WhisperModelDisplayInfo">
                        <Grid Padding="12,10"
                              ColumnSpacing="12"
                              ColumnDefinitions="Auto,*,Auto,Auto"
                              Background="Transparent">

                            <!-- Selection indicator (radio bullet) -->
                            <RadioButton IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                         GroupName="WhisperModel"
                                         MinWidth="0"
                                         VerticalAlignment="Center"
                                         Command="{Binding ViewModel.SelectModelCommand, ElementName=RootPage}"
                                         CommandParameter="{x:Bind Type}" />

                            <!-- Model name -->
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind DisplayName}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <!-- Disk size -->
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind SizeText}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Cache status icon -->
                            <FontIcon Grid.Column="3"
                                      VerticalAlignment="Center"
                                      Glyph="{x:Bind IsCached, Mode=OneWay, Converter={StaticResource CacheGlyphConverter}}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      FontSize="16" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>

</Page>
