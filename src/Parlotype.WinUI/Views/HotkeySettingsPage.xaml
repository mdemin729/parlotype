<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Parlotype.WinUI.Views.HotkeySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Parlotype.WinUI.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24">

            <!-- ── Section: Global Hotkey ──────────────────────── -->
            <TextBlock Text="Global Hotkey"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <TextBlock Text="Configure the keyboard shortcut to activate voice input."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <!-- Hotkey recorder card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    HorizontalAlignment="Left"
                    MinWidth="320">
                <Button x:Name="RecorderButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="12,10"
                        CornerRadius="4"
                        Click="RecorderButton_Click">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.CurrentBindingDisplay, Mode=OneWay}"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <FontIcon Grid.Column="1"
                                  Glyph="&#xE70F;"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Opacity="0.5" />
                    </Grid>
                </Button>
            </Border>

            <!-- Conflict warning -->
            <InfoBar x:Name="ConflictInfoBar"
                     Severity="Warning"
                     Title="Hotkey Conflict"
                     Message="{x:Bind ViewModel.ConflictDescription, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.HasConflict, Mode=OneWay}"
                     IsClosable="False"
                     HorizontalAlignment="Left"
                     MaxWidth="480" />

            <!-- ── Section: Activation Mode ────────────────────── -->
            <TextBlock Text="Activation Mode"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,8,0,0" />

            <TextBlock Text="Choose how the hotkey triggers recording."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <RadioButtons MaxColumns="1">
                <RadioButton Content="Push to Talk"
                             IsChecked="{x:Bind ViewModel.IsPushToTalk, Mode=TwoWay}"
                             GroupName="ActivationMode" />
                <RadioButton Content="Toggle"
                             IsChecked="{x:Bind ViewModel.IsToggle, Mode=TwoWay}"
                             GroupName="ActivationMode" />
            </RadioButtons>

            <TextBlock Text="Push to Talk: hold the hotkey to record, release to stop.&#x0a;Toggle: press once to start, press again to stop."
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

        </StackPanel>
    </ScrollViewer>

</Page>
