<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Parlotype.WinUI.Views.TranscribeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Parlotype.WinUI.ViewModels"
    Title="Parlotype">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drag region -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="Transparent"
              HorizontalAlignment="Stretch">
            <TextBlock Text="Parlotype"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Opacity="0.6" />
        </Grid>

        <!-- Main content -->
        <Border Grid.Row="1"
                CornerRadius="0,0,12,12"
                Padding="16,8,16,16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status text -->
                <TextBlock Grid.Row="0"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Opacity="0.8" />

                <!-- Buttons -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12">

                    <!-- Record / Stop toggle button -->
                    <Button Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                            Width="64"
                            Height="64"
                            CornerRadius="32"
                            ToolTipService.ToolTip="Toggle recording">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Style.Setters>
                                    <Setter Property="Background"
                                            Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Style.Setters>
                            </Style>
                        </Button.Style>
                        <FontIcon Glyph="{x:Bind ViewModel.RecordButtonGlyph, Mode=OneWay}"
                                  FontSize="24" />
                    </Button>

                    <!-- Settings button -->
                    <Button Command="{x:Bind ViewModel.OpenSettingsCommand}"
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Settings">
                        <SymbolIcon Symbol="Setting" />
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
