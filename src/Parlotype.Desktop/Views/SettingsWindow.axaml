<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Parlotype.Desktop.ViewModels"
        xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
        xmlns:v="using:Parlotype.Desktop.Views.Settings"
        x:Class="Parlotype.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        x:CompileBindings="True"
        Title="Parlotype — Settings"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vms:SpeechEngineSettingsViewModel">
            <v:SpeechEngineSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:MicrophoneSettingsViewModel">
            <v:MicrophoneSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:WhisperModelSettingsViewModel">
            <v:WhisperModelSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:RuntimeSettingsViewModel">
            <v:RuntimeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:LlamaCppSettingsViewModel">
            <v:LlamaCppSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:HotkeySettingsViewModel">
            <v:HotkeySettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:ThemeSettingsViewModel">
            <v:ThemeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:SpeechSettingsViewModel">
            <v:SpeechSettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <SplitView IsPaneOpen="True"
               DisplayMode="Inline"
               OpenPaneLength="200">
        <SplitView.Pane>
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    Padding="0,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="20,0,0,12" />
                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vms:SettingsSectionViewModelBase">
                                <TextBlock Text="{Binding Title}" FontSize="14" Padding="6,4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </SplitView.Pane>

        <Border Padding="24">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedSection}" />
            </ScrollViewer>
        </Border>
    </SplitView>
</Window>
