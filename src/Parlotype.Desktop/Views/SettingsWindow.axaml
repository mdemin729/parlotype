<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Parlotype.Desktop.ViewModels"
        xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
        xmlns:v="using:Parlotype.Desktop.Views.Settings"
        x:Class="Parlotype.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        x:CompileBindings="True"
        Title="Parlotype — Settings"
        Width="900" Height="720"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vms:SpeechEngineSettingsViewModel">
            <v:SpeechEngineSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:MicrophoneSettingsViewModel">
            <v:MicrophoneSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:SilenceTimeoutSettingsViewModel">
            <v:SilenceTimeoutSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:WhisperModelSettingsViewModel">
            <v:WhisperModelSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:RuntimeSettingsViewModel">
            <v:RuntimeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:WhisperOutputSettingsViewModel">
            <v:WhisperOutputSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:LanguageSelectionSettingsViewModel">
            <v:LanguageSelectionSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:Gemma4ModelSettingsViewModel">
            <v:Gemma4ModelSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:ParakeetModelSettingsViewModel">
            <v:ParakeetModelSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:CloudProviderSettingsViewModel">
            <v:CloudProviderSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:PromptSettingsViewModel">
            <v:PromptSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:LlamaCppSettingsViewModel">
            <v:LlamaCppSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:HotkeySettingsViewModel">
            <v:HotkeySettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:ThemeSettingsViewModel">
            <v:ThemeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:UpdateSettingsViewModel">
            <v:UpdateSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:DataSettingsViewModel">
            <v:DataSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:HelpSettingsViewModel">
            <v:HelpSettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- Header rows can't be selected or focused. -->
        <Style Selector="ListBoxItem.navHeader">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <SplitView IsPaneOpen="True"
               DisplayMode="Inline"
               OpenPaneLength="200">
        <SplitView.Pane>
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    Padding="0,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="20,0,0,12" />
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="vms:SettingsNavItem">
                                <Setter Property="Classes.navHeader" Value="{Binding IsHeader}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vms:SettingsNavItem">
                                <Panel>
                                    <!-- Group header (non-selectable) -->
                                    <TextBlock Text="{Binding Label}"
                                               IsVisible="{Binding IsHeader}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.55"
                                               Margin="6,12,0,4">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="TextElement.FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    <!-- Section row (selectable) -->
                                    <TextBlock Text="{Binding Label}"
                                               IsVisible="{Binding !IsHeader}"
                                               FontSize="14"
                                               Padding="6,4" />
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </SplitView.Pane>

        <Border Padding="24">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedSection}" />
            </ScrollViewer>
        </Border>
    </SplitView>
</Window>
