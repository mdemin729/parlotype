<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Parlotype.Desktop.ViewModels"
        xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
        xmlns:v="using:Parlotype.Desktop.Views.Settings"
        xmlns:loc="using:Parlotype.Desktop.Markup"
        x:Class="Parlotype.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        x:CompileBindings="True"
        Title="{loc:Tr Settings_WindowTitle}"
        Width="900" Height="770"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vms:SpeechEngineSettingsViewModel">
            <v:SpeechEngineSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:MicrophoneSettingsViewModel">
            <v:MicrophoneSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:SilenceTimeoutSettingsViewModel">
            <v:SilenceTimeoutSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:WhisperModelSettingsViewModel">
            <v:WhisperModelSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:RuntimeSettingsViewModel">
            <v:RuntimeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:WhisperOutputSettingsViewModel">
            <v:WhisperOutputSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:LanguageSelectionSettingsViewModel">
            <v:LanguageSelectionSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:Gemma4ModelSettingsViewModel">
            <v:Gemma4ModelSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:ParakeetModelSettingsViewModel">
            <v:ParakeetModelSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:CloudProviderSettingsViewModel">
            <v:CloudProviderSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:PromptSettingsViewModel">
            <v:PromptSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:LlamaCppSettingsViewModel">
            <v:LlamaCppSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:HotkeySettingsViewModel">
            <v:HotkeySettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:ThemeSettingsViewModel">
            <v:ThemeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:InterfaceLanguageSettingsViewModel">
            <v:InterfaceLanguageSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:StartupSettingsViewModel">
            <v:StartupSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:UpdateSettingsViewModel">
            <v:UpdateSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:DataSettingsViewModel">
            <v:DataSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:HelpSettingsViewModel">
            <v:HelpSettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <!-- Opacity masks for the nav list's edge fades. Applied to the whole
             list (viewport-sized, so the gradient stays put while the rows
             scroll under it) by the code-behind, which picks the variant that
             matches the directions still holding hidden rows. -->
        <LinearGradientBrush x:Key="NavFadeTopMask" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="0.04" Color="#FF000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavFadeBottomMask" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0.96" Color="#FF000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavFadeBothMask" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="0.04" Color="#FF000000" />
            <GradientStop Offset="0.96" Color="#FF000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <!-- Header rows can't be selected or focused. -->
        <Style Selector="ListBoxItem.navHeader">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <SplitView IsPaneOpen="True"
               DisplayMode="Inline"
               OpenPaneLength="200">
        <SplitView.Pane>
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <!-- DockPanel, not StackPanel: a stacked list is measured with
                     infinite height, so it never scrolls - it just grew past the
                     bottom of the pane and hid its last rows. Docking the
                     heading and letting the list fill what's left gives the list
                     a real viewport to scroll inside. -->
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Tr Settings_NavHeading}"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="20,16,0,12" />
                    <ListBox x:Name="NavList"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,0,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!-- Stock Fluent scrollbar, deliberately: at rest it is
                             already a visible thin line whenever the content
                             overflows - the same one the section pane shows - so
                             the pane needed a viewport, not a new bar. Do not
                             pin it with ScrollViewer.AllowAutoHide="False": that
                             snaps Fluent to its wide expanded bar with stepper
                             arrows, which no other list in the app wears. -->
                        <!-- Plain stack, not the virtualizing default: two dozen
                             short rows never need recycling, and a non-estimated
                             extent means smooth pixel scrolling and a scrollbar
                             thumb that doesn't resize itself as it travels. -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="vms:SettingsNavItem">
                                <Setter Property="Classes.navHeader" Value="{Binding IsHeader}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vms:SettingsNavItem">
                                <Panel>
                                    <!-- Group header (non-selectable) -->
                                    <TextBlock Text="{Binding Label}"
                                               IsVisible="{Binding IsHeader}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.55"
                                               Margin="6,12,0,4">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="TextElement.FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    <!-- Section row (selectable) -->
                                    <TextBlock Text="{Binding Label}"
                                               IsVisible="{Binding !IsHeader}"
                                               FontSize="14"
                                               Padding="6,4" />
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </SplitView.Pane>

        <Border Padding="24">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedSection}" />
            </ScrollViewer>
        </Border>
    </SplitView>
</Window>
