<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Parlotype.Desktop.ViewModels"
        x:Class="Parlotype.Desktop.Views.ModelDownloadDialog"
        x:DataType="vm:ModelDownloadViewModel"
        x:CompileBindings="True"
        Title="Model Download"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:ModelDownloadViewModel />
    </Design.DataContext>

    <Border Padding="24">
        <StackPanel Spacing="16">

            <!-- Status / prompt text -->
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       FontSize="14" />

            <!-- Progress bar (visible during download) -->
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsVisible="{Binding IsDownloading}"
                         Height="6"
                         CornerRadius="3" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">

                <!-- Download button (visible before download starts) -->
                <Button Name="DownloadButton"
                        Content="Download"
                        IsVisible="{Binding !IsDownloading}"
                        Classes="accent"
                        MinWidth="90"
                        HorizontalContentAlignment="Center" />

                <!-- Cancel button (always visible) -->
                <Button Name="CancelButton"
                        Content="Cancel"
                        MinWidth="90"
                        HorizontalContentAlignment="Center" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
