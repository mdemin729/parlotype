<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Parlotype.Desktop.ViewModels"
        x:Class="Parlotype.Desktop.Views.ModelDownloadDialog"
        x:DataType="vm:ModelDownloadViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:ModelDownloadViewModel />
    </Design.DataContext>

    <Border Padding="24">
        <StackPanel Spacing="16">

            <!-- Status / prompt text -->
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       FontSize="14" />

            <!-- Byte counter on its own line (kept separate so its changing
                 width does not reflow the status text above) -->
            <TextBlock Text="{Binding ProgressText}"
                       IsVisible="{Binding IsDownloading}"
                       TextWrapping="NoWrap"
                       FontSize="13"
                       Opacity="0.7" />

            <!-- Progress bar (visible during download) -->
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsVisible="{Binding IsDownloading}"
                         Height="6"
                         CornerRadius="3" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">

                <!-- Download button (visible before download starts / after failure) -->
                <Button Name="DownloadButton"
                        Content="{Binding DownloadButtonText}"
                        IsVisible="{Binding ShowDownloadButton}"
                        Classes="accent"
                        MinWidth="90"
                        HorizontalContentAlignment="Center" />

                <!-- Cancel button (visible until download completes) -->
                <Button Name="CancelButton"
                        Content="Cancel"
                        IsVisible="{Binding ShowCancelButton}"
                        MinWidth="90"
                        HorizontalContentAlignment="Center" />

                <!-- Close button (visible only after successful completion) -->
                <Button Name="CloseButton"
                        Content="Close"
                        IsVisible="{Binding ShowCloseButton}"
                        Classes="accent"
                        MinWidth="90"
                        HorizontalContentAlignment="Center" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
