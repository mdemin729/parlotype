<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             x:Class="Parlotype.Desktop.Views.Settings.ThemeSettingsView"
             x:DataType="vms:ThemeSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="12">
        <TextBlock Text="Theme" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Choose between system, light, or dark appearance."
                   Opacity="0.7" />

        <ItemsControl ItemsSource="{Binding ThemeOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeDisplayItem">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            Padding="12,8"
                            Margin="0,2"
                            Command="{Binding SelectCommand}"
                            CommandParameter="{Binding Theme}">
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
