<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             xmlns:loc="using:Parlotype.Desktop.Markup"
             xmlns:v="using:Parlotype.Desktop.Views"
             x:Class="Parlotype.Desktop.Views.Settings.CloudProviderSettingsView"
             x:DataType="vms:CloudProviderSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="16">
        <TextBlock Text="{loc:Tr Settings_CloudProviders_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="{loc:Tr Settings_CloudProviders_Intro}" />

        <!-- ============================================================
             OpenAI-compatible
             ============================================================ -->
        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr Settings_CloudProviders_OpenAi_Name}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Tr Settings_CloudProviders_OpenAi_Description}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Settings_CloudProviders_BaseUrlLabel}" FontSize="12" Opacity="0.7" />
                    <TextBox Text="{Binding OpenAiBaseUrl, Mode=TwoWay}"
                             PlaceholderText="{x:Static vms:CloudProviderSettingsViewModel.DefaultOpenAiBaseUrl}" />
                    <TextBlock Text="{Binding OpenAiBaseUrlError}"
                               IsVisible="{Binding OpenAiBaseUrlError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Settings_CloudProviders_ModelLabel}" FontSize="12" Opacity="0.7" />
                    <TextBox Text="{Binding OpenAiModel, Mode=TwoWay}"
                             PlaceholderText="{x:Static vms:CloudProviderSettingsViewModel.DefaultOpenAiModel}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Settings_CloudProviders_ApiKeyLabel}" FontSize="12" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{loc:Tr Settings_CloudProviders_KeySavedBadge}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   IsVisible="{Binding ShowOpenAiKeySaved}" />
                    </Grid>

                    <!-- Saved: read-only mask + Change / Remove -->
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowOpenAiKeySaved}">
                        <TextBox Grid.Column="0"
                                 Text="{x:Static vms:CloudProviderSettingsViewModel.KeyMask}"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{loc:Tr Settings_CloudProviders_ChangeButton}"
                                Command="{Binding ChangeOpenAiKeyCommand}"
                                Padding="12,6" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="{loc:Tr Settings_CloudProviders_RemoveButton}"
                                Command="{Binding RemoveOpenAiKeyCommand}"
                                Padding="12,6" />
                    </Grid>

                    <!-- Empty / editing: password entry with reveal toggle + Save / Cancel -->
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowOpenAiKeyEntry}">
                        <v:ApiKeyBox Grid.Column="0"
                                     Text="{Binding OpenAiKeyEntry, Mode=TwoWay}"
                                     IsRevealed="{Binding IsOpenAiKeyRevealed, Mode=TwoWay}"
                                     PlaceholderText="sk-…"
                                     Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{loc:Tr Settings_CloudProviders_SaveButton}"
                                Command="{Binding SaveOpenAiKeyCommand}"
                                Padding="12,6" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="{loc:Tr Common_Cancel}"
                                Command="{Binding CancelEditOpenAiKeyCommand}"
                                IsVisible="{Binding CanCancelOpenAiEdit}"
                                Padding="12,6" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================================================
             xAI Grok
             ============================================================ -->
        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr Settings_CloudProviders_Xai_Name}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Tr Settings_CloudProviders_Xai_Description}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Settings_CloudProviders_BaseUrlLabel}" FontSize="12" Opacity="0.7" />
                    <TextBox Text="{Binding XaiBaseUrl, Mode=TwoWay}"
                             PlaceholderText="{x:Static vms:CloudProviderSettingsViewModel.DefaultXaiBaseUrl}" />
                    <TextBlock Text="{Binding XaiBaseUrlError}"
                               IsVisible="{Binding XaiBaseUrlError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Settings_CloudProviders_ModelLabel}" FontSize="12" Opacity="0.7" />
                    <TextBox Text="{Binding XaiModel, Mode=TwoWay}"
                             PlaceholderText="{x:Static vms:CloudProviderSettingsViewModel.DefaultXaiModel}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Settings_CloudProviders_ApiKeyLabel}" FontSize="12" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{loc:Tr Settings_CloudProviders_KeySavedBadge}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   IsVisible="{Binding ShowXaiKeySaved}" />
                    </Grid>

                    <!-- Saved: read-only mask + Change / Remove -->
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowXaiKeySaved}">
                        <TextBox Grid.Column="0"
                                 Text="{x:Static vms:CloudProviderSettingsViewModel.KeyMask}"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{loc:Tr Settings_CloudProviders_ChangeButton}"
                                Command="{Binding ChangeXaiKeyCommand}"
                                Padding="12,6" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="{loc:Tr Settings_CloudProviders_RemoveButton}"
                                Command="{Binding RemoveXaiKeyCommand}"
                                Padding="12,6" />
                    </Grid>

                    <!-- Empty / editing: password entry with reveal toggle + Save / Cancel -->
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowXaiKeyEntry}">
                        <v:ApiKeyBox Grid.Column="0"
                                     Text="{Binding XaiKeyEntry, Mode=TwoWay}"
                                     IsRevealed="{Binding IsXaiKeyRevealed, Mode=TwoWay}"
                                     PlaceholderText="xai-…"
                                     Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{loc:Tr Settings_CloudProviders_SaveButton}"
                                Command="{Binding SaveXaiKeyCommand}"
                                Padding="12,6" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Content="{loc:Tr Common_Cancel}"
                                Command="{Binding CancelEditXaiKeyCommand}"
                                IsVisible="{Binding CanCancelXaiEdit}"
                                Padding="12,6" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
