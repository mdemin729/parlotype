<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             x:Class="Parlotype.Desktop.Views.Settings.RuntimeSettingsView"
             x:DataType="vms:RuntimeSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="12">
        <TextBlock Text="Runtime" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Choose which Whisper.net backend runs the speech model. Changes take effect after restart."
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding RuntimeOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RuntimeDisplayItem">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            Padding="12,8"
                            Margin="0,2"
                            Command="{Binding SelectCommand}"
                            CommandParameter="{Binding Type}">
                        <Grid ColumnDefinitions="11,*" RowDefinitions="Auto,Auto,Auto">
                            <Border Grid.Column="0" Grid.RowSpan="3"
                                    Width="3" Height="16" CornerRadius="1.5"
                                    Background="{DynamicResource SystemAccentColor}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding IsSelected}" />
                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Text="{Binding DisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{Binding Description}"
                                       FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Grid.Row="2"
                                       Text="{Binding UnavailableReason}"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       IsVisible="{Binding !IsAvailable}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- CUDA: no NVIDIA driver detected -->
        <StackPanel Spacing="4" IsVisible="{Binding CudaDriverMissing}" Margin="0,8,0,0">
            <TextBlock Text="NVIDIA GPU not detected"
                       FontWeight="SemiBold" FontSize="14" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7">
                CUDA requires an NVIDIA graphics card with drivers installed.
                If your computer has an NVIDIA GPU, make sure the latest drivers
                are installed, then restart Parlotype.
            </TextBlock>
        </StackPanel>

        <!-- CUDA: driver found, but CUDA toolkit/SDK missing -->
        <StackPanel Spacing="4" IsVisible="{Binding CudaSdkMissing}" Margin="0,8,0,0">
            <TextBlock Text="CUDA toolkit not installed"
                       FontWeight="SemiBold" FontSize="14" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7">
                <Run Text="Your NVIDIA driver (version" />
                <Run Text="{Binding CudaDriverVersion}" FontWeight="SemiBold" />
                <Run Text=") is ready, but the CUDA toolkit is missing. The toolkit lets Parlotype use your GPU for faster speech recognition." />
            </TextBlock>
            <TextBlock Text="To get started:" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="8,0,0,0"
                       Text="1. Download the CUDA toolkit from NVIDIA's website&#x0a;2. Run the installer and follow the prompts&#x0a;3. Restart Parlotype" />
            <Button Content="Download CUDA Toolkit →"
                    Command="{Binding OpenCudaDownloadLinkCommand}"
                    Padding="12,6"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold" />
        </StackPanel>

        <!-- Vulkan loader missing -->
        <StackPanel Spacing="4" IsVisible="{Binding VulkanLoaderMissing}" Margin="0,8,0,0">
            <TextBlock Text="Vulkan loader (vulkan-1.dll) was not detected on this system."
                       Opacity="0.7" TextWrapping="Wrap" />
            <Button Content="Download Vulkan SDK →"
                    Command="{Binding OpenVulkanSdkLinkCommand}"
                    Padding="12,6"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</UserControl>
