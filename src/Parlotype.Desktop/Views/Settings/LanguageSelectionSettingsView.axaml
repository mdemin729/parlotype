<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settingsViews="using:Parlotype.Desktop.Views.Settings"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             x:Class="Parlotype.Desktop.Views.Settings.LanguageSelectionSettingsView"
             x:DataType="vms:LanguageSelectionSettingsViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <!-- Active language button gets a green focus border (matches prototype). -->
        <Style Selector="Button.languageBtn">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.languageBtn.active">
            <Setter Property="BorderBrush" Value="#22C55E" />
        </Style>

        <!-- Arrow toggle: dimmed when translation is off. -->
        <Style Selector="Button.arrow">
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
        <Style Selector="Button.arrow.off">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">
        <TextBlock Text="Language" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Pick the spoken (source) language and, optionally, a translation target. The arrow toggles translation on and off."
                   Opacity="0.7" TextWrapping="Wrap" />

        <!-- Source ↔ Target button row -->
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="Source language" Opacity="0.8" />
                <Button Classes="languageBtn"
                        Classes.active="{Binding IsSourcePickerOpen}"
                        Command="{Binding OpenSourcePickerCommand}"
                        Content="{Binding SourceButtonLabel}" />
            </StackPanel>

            <Button Classes="arrow"
                    Classes.off="{Binding !TranslationEnabled}"
                    Command="{Binding ToggleTranslationCommand}"
                    VerticalAlignment="Bottom"
                    ToolTip.Tip="Toggle translation">
                <TextBlock Text="→" FontSize="18" />
            </Button>

            <StackPanel Spacing="4">
                <TextBlock Text="Target language" Opacity="0.8" />
                <Button Classes="languageBtn"
                        Classes.active="{Binding IsTargetPickerOpen}"
                        IsEnabled="{Binding IsTargetButtonEnabled}"
                        Command="{Binding OpenTargetPickerCommand}"
                        Content="{Binding TargetButtonLabel}" />
            </StackPanel>
        </StackPanel>

        <!-- "Translation paused" hint (Whisper + non-translation-capable model). -->
        <TextBlock Text="{Binding TranslationPausedNote}"
                   Foreground="{DynamicResource SystemAccentColor}"
                   FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding ShowTranslationPausedNote}" />

        <!-- Inline picker (only one is visible at a time — each picker self-hosts
             its IsVisible via LanguagePickerViewModel.IsOpen). -->
        <settingsViews:LanguagePickerView DataContext="{Binding SourcePicker}" />
        <settingsViews:LanguagePickerView DataContext="{Binding TargetPicker}" />
    </StackPanel>
</UserControl>
