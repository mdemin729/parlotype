<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settingsViews="using:Parlotype.Desktop.Views.Settings"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             x:Class="Parlotype.Desktop.Views.Settings.LanguageSelectionSettingsView"
             x:DataType="vms:LanguageSelectionSettingsViewModel"
             x:CompileBindings="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Warn (translation unavailable / paused) tokens per the redlines.
                     Deliberately per-view rather than app-scoped: the headless
                     screenshot tests host controls under their own Application, so
                     an App.axaml dictionary would silently vanish from every
                     rendering test that verifies this state. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WarnForegroundBrush" Color="#E0A23A" />
                    <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#24E0A23A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WarnForegroundBrush" Color="#B9791B" />
                    <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#24E0A23A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Picker field: icon tile + label + sub-hint, opens the popover. -->
        <Style Selector="Button.pickerField">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="MinWidth" Value="210" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button.pickerField.open">
            <Setter Property="BorderBrush" Value="#378ADD" />
        </Style>

        <!-- Connector pill: the translation on/off control (spec §1). -->
        <Style Selector="Button.connector">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.connector.on">
            <Setter Property="Background" Value="#378ADD" />
        </Style>
        <!-- Scoped to the glyph's own class, never a bare descendant TextBlock:
             a tooltip's content is a logical child of the control it hangs off,
             so `Button.connector.on TextBlock` also repainted the tooltip's text
             white on its light background — an invisible tooltip (ADR-061). -->
        <Style Selector="Button.connector.on TextBlock.connectorGlyph">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.connector.off">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.connector.locked">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Paused: on but not acting. Amber rather than accent so it never
             reads as a working translation (ADR-061). -->
        <Style Selector="Button.connector.paused">
            <Setter Property="Background" Value="#C68A28" />
        </Style>
        <Style Selector="Button.connector.paused TextBlock.connectorGlyph">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.targetCard.paused">
            <Setter Property="BorderBrush" Value="#C68A28" />
        </Style>

        <Style Selector="TextBlock.fieldCaption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14">
        <TextBlock Text="Language" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="One relationship, read left to right: you speak the source, Parlotype types the target. The connector between them turns translation on and off."
                   Opacity="0.7" TextWrapping="Wrap" />

        <!-- Source | connector | target -->
        <Grid ColumnDefinitions="*,Auto,*" Margin="0,6,0,0">

            <!-- Source card -->
            <StackPanel Grid.Column="0">
                <TextBlock Classes="fieldCaption" Text="You speak" />
                <Button x:Name="SourceField"
                        Classes="pickerField"
                        Classes.open="{Binding SourcePicker.IsOpen}"
                        Command="{Binding OpenSourcePickerCommand}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Width="34" Height="34" CornerRadius="8"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SourceTileText}"
                                       FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0"
                                    VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Relationship.SourceDisplayLabel}" FontSize="14" />
                            <TextBlock Text="{Binding Relationship.SourceSubHint}"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Connector -->
            <Button Grid.Column="1"
                    Classes="connector"
                    Classes.on="{Binding Relationship.IsConnectorOn}"
                    Classes.off="{Binding Relationship.IsConnectorOff}"
                    Classes.locked="{Binding Relationship.IsConnectorLocked}"
                    Classes.paused="{Binding Relationship.IsTranslationPaused}"
                    IsEnabled="{Binding !Relationship.IsConnectorLocked}"
                    Command="{Binding ToggleTranslationCommand}"
                    Margin="14,18,14,0"
                    VerticalAlignment="Top"
                    ToolTip.Tip="{Binding Relationship.ConnectorTooltip}">
                <TextBlock Classes="connectorGlyph"
                           Text="{Binding Relationship.ConnectorGlyph}" FontSize="17" />
            </Button>

            <!-- Target side: form picked by the engine's capabilities (spec §4). -->
            <StackPanel Grid.Column="2">
                <TextBlock Classes="fieldCaption" Text="Parlotype types" />

                <!-- Toggle form (Whisper): a labelled switch, never a list. -->
                <Border Classes="targetCard"
                        Classes.paused="{Binding Relationship.IsTranslationPaused}"
                        IsVisible="{Binding Relationship.IsToggleForm}"
                        MinHeight="60" CornerRadius="10"
                        BorderThickness="1.5" Padding="14,13"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Relationship.ToggleSwitchLabel}"
                                       FontSize="14" />
                            <!-- The switch stays on and operable: the preference is
                                 kept, only its effect is suspended (ADR-061). -->
                            <TextBlock Text="Paused — this model can't translate"
                                       IsVisible="{Binding Relationship.IsTranslationPaused}"
                                       Foreground="{DynamicResource WarnForegroundBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding Relationship.TranslationSwitch, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <!-- Full form (Gemma): picker field → popover. -->
                <Button x:Name="TargetField"
                        IsVisible="{Binding Relationship.IsFullForm}"
                        Classes="pickerField"
                        Classes.open="{Binding TargetPicker.IsOpen}"
                        Command="{Binding OpenTargetPickerCommand}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Width="34" Height="34" CornerRadius="8"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TargetTileText}"
                                       FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0"
                                    VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Relationship.TargetDisplayLabel}" FontSize="14" />
                            <TextBlock Text="{Binding TargetSubHint}"
                                       FontSize="12" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- None form: disabled card; the amber note below explains. -->
                <Border IsVisible="{Binding Relationship.IsNoneForm}"
                        MinHeight="60" CornerRadius="10"
                        BorderThickness="1.5" Padding="14,13" Opacity="0.5"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Width="34" Height="34" CornerRadius="8"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="⊘" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0"
                                    VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Translation unavailable" FontSize="14" />
                            <TextBlock Text="Not supported by this model"
                                       FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Plain-language summary of the relationship (spec §7). -->
        <TextBlock Text="{Binding Relationship.SummaryText}"
                   FontSize="13" Opacity="0.75" TextWrapping="Wrap" />

        <!-- Paused banner (Whisper + non-translation-capable model, ADR-033/061).
             Amber like the unavailable note, but it names the model and offers
             the one action that resumes translation. -->
        <Border IsVisible="{Binding Relationship.IsTranslationPaused}"
                Background="{DynamicResource WarnBackgroundBrush}"
                CornerRadius="8" Padding="12,8">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Relationship.TranslationPausedNote}"
                           Foreground="{DynamicResource WarnForegroundBrush}"
                           FontSize="12" TextWrapping="Wrap" />
                <Button Content="Choose a model that translates"
                        Command="{Binding GoToWhisperModelCommand}"
                        HorizontalAlignment="Left"
                        FontSize="12" Padding="10,4" CornerRadius="6" />
            </StackPanel>
        </Border>

        <!-- Amber unavailable note, naming the model (spec §4, none form only). -->
        <Border IsVisible="{Binding Relationship.IsNoneForm}"
                Background="{DynamicResource WarnBackgroundBrush}"
                CornerRadius="8" Padding="12,8">
            <TextBlock Text="{Binding Relationship.UnavailableNote}"
                       Foreground="{DynamicResource WarnForegroundBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Transient fallback toast (spec §8); auto-clears from the VM. -->
        <Border Background="#29378ADD" BorderBrush="#378ADD" BorderThickness="1"
                CornerRadius="8" Padding="12,8"
                IsVisible="{Binding Relationship.ToastMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Relationship.ToastMessage}"
                       FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Floating popovers anchored to their fields (spec §6). -->
        <Popup PlacementTarget="{Binding #SourceField}"
               Placement="BottomEdgeAlignedLeft"
               VerticalOffset="6"
               IsLightDismissEnabled="True"
               IsOpen="{Binding SourcePicker.IsOpen, Mode=TwoWay}">
            <Border Classes="popoverChrome" Width="300">
                <settingsViews:LanguagePickerView DataContext="{Binding SourcePicker}" />
            </Border>
        </Popup>
        <Popup PlacementTarget="{Binding #TargetField}"
               Placement="BottomEdgeAlignedLeft"
               VerticalOffset="6"
               IsLightDismissEnabled="True"
               IsOpen="{Binding TargetPicker.IsOpen, Mode=TwoWay}">
            <Border Classes="popoverChrome" Width="300">
                <settingsViews:LanguagePickerView DataContext="{Binding TargetPicker}" />
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
