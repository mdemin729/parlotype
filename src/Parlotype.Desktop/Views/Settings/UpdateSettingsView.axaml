<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             xmlns:loc="using:Parlotype.Desktop.Markup"
             x:Class="Parlotype.Desktop.Views.Settings.UpdateSettingsView"
             x:DataType="vms:UpdateSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="16">
        <TextBlock Text="{loc:Tr Settings_Updates_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Tr Settings_Updates_Description}"
                   Opacity="0.7" TextWrapping="Wrap" />

        <!-- Automatic checks -->
        <StackPanel Spacing="4">
            <ToggleSwitch IsChecked="{Binding CheckAutomatically, Mode=TwoWay}"
                          IsEnabled="{Binding IsUpdateSupported}"
                          OnContent="{loc:Tr Settings_Updates_ToggleOn}"
                          OffContent="{loc:Tr Settings_Updates_ToggleOff}" />
            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr Settings_Updates_CadenceNote}" />
        </StackPanel>

        <!-- Privacy note: this is the only outbound request the app makes in local mode. -->
        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="4" Padding="12">
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Settings_Updates_WhatSendsHeading}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                           Text="{loc:Tr Settings_Updates_WhatSendsBody}" />
            </StackPanel>
        </Border>

        <Border Height="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Margin="0,4" />

        <!-- Status -->
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Tr Settings_Updates_InstalledVersionLabel}" Opacity="0.6" FontSize="12" />
                <TextBlock Text="{Binding CurrentVersionText}" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Tr Settings_Updates_LastCheckedLabel}" Opacity="0.6" FontSize="12" />
                <TextBlock Text="{Binding LastCheckedText}" FontSize="12" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Settings_Updates_CheckNowButton}"
                    Command="{Binding CheckNowCommand}"
                    IsEnabled="{Binding IsUpdateSupported}" />
            <Button Content="{loc:Tr Settings_Updates_InstallAndRestartButton}"
                    Command="{Binding RestartNowCommand}"
                    IsVisible="{Binding IsRestartRequired}"
                    Classes="accent" />
            <ProgressBar IsIndeterminate="True"
                         Width="80" Height="4"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsBusy}" />
        </StackPanel>
    </StackPanel>
</UserControl>
