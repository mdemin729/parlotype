<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             xmlns:onb="using:Parlotype.Desktop.Onboarding"
             x:Class="Parlotype.Desktop.Views.Settings.WhisperModelSettingsView"
             x:DataType="vms:WhisperModelSettingsViewModel"
             x:CompileBindings="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Warn (translation unavailable / paused) tokens per the redlines.
                     Deliberately per-view rather than app-scoped: the headless
                     screenshot tests host controls under their own Application, so
                     an App.axaml dictionary would silently vanish from every
                     rendering test that verifies this state. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WarnForegroundBrush" Color="#E0A23A" />
                    <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#24E0A23A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WarnForegroundBrush" Color="#B9791B" />
                    <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#24E0A23A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <TextBlock Text="Whisper Model" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Larger models are more accurate but use more disk and CPU/GPU."
                   Opacity="0.7" />

        <ItemsControl ItemsSource="{Binding ModelOptions}"
                      onb:OnboardingTarget.Id="{x:Static onb:OnboardingTargetIds.SettingsModelList}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WhisperModelDisplayItem">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            Padding="12,8"
                            Margin="0,2"
                            Command="{Binding SelectCommand}"
                            CommandParameter="{Binding Type}">
                        <Grid ColumnDefinitions="11,Auto,*,Auto,Auto">
                            <Border Grid.Column="0"
                                    Width="3" Height="16" CornerRadius="1.5"
                                    Background="{DynamicResource SystemAccentColor}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding IsSelected}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <!-- A capability, not a footnote: these models cannot
                                 run Whisper's translate task at all, which is the
                                 whole reason translation pauses (ADR-033/ADR-061). -->
                            <Border Grid.Column="2"
                                    IsVisible="{Binding !SupportsTranslation}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0" Padding="6,1"
                                    CornerRadius="5" BorderThickness="1"
                                    Background="{DynamicResource WarnBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarnForegroundBrush}"
                                    ToolTip.Tip="Transcription only — translating to English needs a multilingual model">
                                <TextBlock Text="no translation"
                                           FontSize="11"
                                           Foreground="{DynamicResource WarnForegroundBrush}" />
                            </Border>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding DiskSize}"
                                       FontSize="13" Opacity="0.5"
                                       VerticalAlignment="Center"
                                       Margin="24,0,0,0" />
                            <TextBlock Grid.Column="4"
                                       Text="(not downloaded)"
                                       FontSize="12"
                                       Opacity="0.5"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       IsVisible="{Binding !IsCached}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
