<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             xmlns:loc="using:Parlotype.Desktop.Markup"
             x:Class="Parlotype.Desktop.Views.Settings.StartupSettingsView"
             x:DataType="vms:StartupSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="16">
        <TextBlock Text="{loc:Tr Settings_Startup_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Tr Settings_Startup_Description}"
                   Opacity="0.7" TextWrapping="Wrap" />

        <StackPanel Spacing="4">
            <ToggleSwitch IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"
                          IsEnabled="{Binding IsSupported}"
                          OnContent="{loc:Tr Settings_Startup_ToggleOn}"
                          OffContent="{loc:Tr Settings_Startup_ToggleOff}" />
            <TextBlock Text="{Binding StatusText}"
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Only Task Manager can lift its own veto, so send the user there
             rather than implying this switch can override it. -->
        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="4" Padding="12"
                IsVisible="{Binding IsBlockedByWindows}">
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Settings_Startup_BlockedHeading}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                           Text="{loc:Tr Settings_Startup_BlockedBody}" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="4" Padding="12"
                IsVisible="{Binding IsSupported}">
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Settings_Startup_WhatChangesHeading}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                           Text="{loc:Tr Settings_Startup_WhatChangesBody}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
