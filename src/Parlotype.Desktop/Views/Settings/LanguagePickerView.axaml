<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             x:Class="Parlotype.Desktop.Views.Settings.LanguagePickerView"
             x:DataType="vm:LanguagePickerViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Button.langRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- Selected row: accent-soft background + accent primary label (redlines). -->
        <Style Selector="Button.langRow.selected">
            <Setter Property="Background" Value="#29378ADD" />
        </Style>
        <Style Selector="Button.langRow.selected TextBlock.primary">
            <Setter Property="Foreground" Value="#378ADD" />
        </Style>

        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="10,10,0,4" />
        </Style>
    </UserControl.Styles>

    <Border Width="300"
            CornerRadius="10"
            BorderThickness="1"
            Padding="10"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BoxShadow="0 8 24 0 #66000000">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding Header}" FontSize="13" Opacity="0.85" Margin="2,0,0,0" />

            <!-- Search appears only for long lists (> 8 entries). -->
            <TextBox x:Name="SearchBox"
                     Text="{Binding Filter, Mode=TwoWay}"
                     PlaceholderText="Search languages…"
                     IsVisible="{Binding ShowSearch}" />

            <!-- Empty state: centred icon at 50% + the query named. -->
            <StackPanel IsVisible="{Binding HasNoResults}"
                        HorizontalAlignment="Center"
                        Spacing="6" Margin="0,18,0,18">
                <PathIcon Width="22" Height="22" Opacity="0.5"
                          HorizontalAlignment="Center"
                          Data="M 9.5,1.5 a 8,8 0 1 0 4.9,14.3 l 5.4,5.4 1.4,-1.4 -5.4,-5.4 A 8,8 0 0 0 9.5,1.5 Z M 9.5,3.5 a 6,6 0 1 1 0,12 6,6 0 0 1 0,-12 Z" />
                <TextBlock Text="{Binding NoResultsText}"
                           Opacity="0.6" FontSize="13"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LanguageDisplayItem">
                            <StackPanel>
                                <!-- Group label ("Recent" / "All languages"). -->
                                <TextBlock Classes="groupHeader"
                                           Text="{Binding DisplayName}"
                                           IsVisible="{Binding IsHeader}" />

                                <!-- Selectable row: icon tile, names, trailing check. -->
                                <Button Classes="langRow"
                                        Classes.selected="{Binding IsSelected}"
                                        IsVisible="{Binding !IsHeader}"
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding Code}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0"
                                                Width="34" Height="34" CornerRadius="8"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TileText}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Opacity="0.85"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="11,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Spacing="1">
                                            <TextBlock Classes="primary"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="14" />
                                            <TextBlock Text="{Binding SecondaryText}"
                                                       FontSize="12" Opacity="0.6"
                                                       IsVisible="{Binding HasSecondaryText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="✓"
                                                   Foreground="#378ADD"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,2,0"
                                                   IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
