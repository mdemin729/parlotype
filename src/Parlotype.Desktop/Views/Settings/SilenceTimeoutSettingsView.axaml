<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             x:Class="Parlotype.Desktop.Views.Settings.SilenceTimeoutSettingsView"
             x:DataType="vms:SilenceTimeoutSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="16">
        <TextBlock Text="Silence timeout" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="How long to wait after speech ends before transcribing."
                   Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock Text="Applies when you toggle dictation on and off. Hold-to-talk ignores this — holding the key already says when you are done, so the whole hold is transcribed at once."
                   Opacity="0.7" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding WaitTimeOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WaitTimeDisplayItem">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            Padding="12,8"
                            Margin="0,2"
                            Command="{Binding SelectCommand}"
                            CommandParameter="{Binding Option}">
                        <Grid ColumnDefinitions="11,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="16" CornerRadius="1.5"
                                    Background="{DynamicResource SystemAccentColor}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding IsSelected}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
