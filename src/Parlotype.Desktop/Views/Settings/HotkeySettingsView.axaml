<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             x:Class="Parlotype.Desktop.Views.Settings.HotkeySettingsView"
             x:DataType="vms:HotkeySettingsViewModel"
             x:CompileBindings="True"
             Focusable="True">
    <StackPanel Spacing="12">
        <TextBlock Text="Hotkey" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Press the recorder, then press your desired key combination."
                   Opacity="0.7" />

        <Button Name="RecorderButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="12,10"
                Command="{Binding StartRecordingCommand}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding DisplayText}"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="✎" Opacity="0.5"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>

        <TextBlock Text="{Binding ConflictWarning}"
                   IsVisible="{Binding ConflictWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="Orange"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <TextBlock Text="Activation mode" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton Content="Push to Talk"
                         IsChecked="{Binding IsPushToTalk}"
                         GroupName="ActivationModeV2" />
            <RadioButton Content="Toggle"
                         IsChecked="{Binding IsToggle}"
                         GroupName="ActivationModeV2" />
        </StackPanel>
    </StackPanel>
</UserControl>
