<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             xmlns:loc="using:Parlotype.Desktop.Markup"
             x:Class="Parlotype.Desktop.Views.Settings.HotkeySettingsView"
             x:DataType="vms:HotkeySettingsViewModel"
             x:CompileBindings="True"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="Border.bindingRow">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="12">
        <TextBlock Text="{loc:Tr Settings_Hotkeys_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Tr Settings_Hotkeys_Description}"
                   Opacity="0.7" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Bindings}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vms:HotkeyBindingItemViewModel">
                    <Border Classes="bindingRow">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayString}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Content="{Binding ModeLabel}"
                                    Command="{Binding ToggleModeCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanChangeMode}"
                                    FontSize="12"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Tr Settings_Hotkeys_ModeToggleTooltip}" />

                            <Button Grid.Column="2"
                                    Command="{Binding RemoveCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Width="28" Height="28"
                                    Padding="0"
                                    CornerRadius="6"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="{loc:Tr Settings_Hotkeys_RemoveTooltip}">
                                <TextBlock Text="&#x2715;" FontSize="12" Opacity="0.7" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{loc:Tr Settings_Hotkeys_None}"
                   IsVisible="{Binding !HasBindings}"
                   Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Settings_Hotkeys_AddButton}" Padding="12,8">
                <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding Presets}">
                        <MenuFlyout.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                          x:DataType="vms:HotkeyPresetViewModel">
                                <Setter Property="Header" Value="{Binding DisplayString}" />
                                <Setter Property="Command" Value="{Binding AddCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding Hotkey}" />
                            </ControlTheme>
                        </MenuFlyout.ItemContainerTheme>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button Name="RecorderButton"
                    Content="{Binding RecorderText}"
                    Command="{Binding StartRecordingCommand}"
                    Padding="12,8" />
        </StackPanel>

        <TextBlock Classes="warn"
                   Text="{Binding BlockingWarning}"
                   IsVisible="{Binding BlockingWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="#E05252" />

        <TextBlock Classes="warn"
                   Text="{Binding AdvisoryWarning}"
                   IsVisible="{Binding AdvisoryWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="Orange" />
    </StackPanel>
</UserControl>
