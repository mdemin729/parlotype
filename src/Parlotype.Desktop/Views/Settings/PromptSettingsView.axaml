<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             xmlns:vms="using:Parlotype.Desktop.ViewModels.Settings"
             xmlns:loc="using:Parlotype.Desktop.Markup"
             x:Class="Parlotype.Desktop.Views.Settings.PromptSettingsView"
             x:DataType="vms:PromptSettingsViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="12">
        <TextBlock Text="{loc:Tr Settings_Prompts_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Tr Settings_Prompts_Description}"
                   Opacity="0.7" TextWrapping="Wrap" />

        <!-- Collapsed help: placeholders, the translation trigger, and why the
             built-in default reads the way it does. Collapsed by default so the
             page stays compact; IsExpanded is session-only VM state. -->
        <Expander Header="{loc:Tr Settings_Prompts_HelpHeader}"
                  IsExpanded="{Binding IsHelpExpanded}"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding !IsEditing}">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Settings_Prompts_Help_PlaceholdersHeading}" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75">
                        <Run Text="{}{speech_lang}" FontWeight="SemiBold" />
                        <Run Text="{loc:Tr Settings_Prompts_Help_SpeechLangDescription}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75">
                        <Run Text="{}{text_lang}" FontWeight="SemiBold" />
                        <Run Text="{loc:Tr Settings_Prompts_Help_TextLangDescription}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Settings_Prompts_Help_TranslationHeading}" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="{loc:Tr Settings_Prompts_Help_TranslationBody}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Settings_Prompts_Help_BuiltInHeading}" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="{loc:Tr Settings_Prompts_Help_BuiltInBody}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="{loc:Tr Settings_Prompts_Help_CustomBody}" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Prompt list (hidden while editing) -->
        <StackPanel Spacing="4" IsVisible="{Binding !IsEditing}">
            <ItemsControl ItemsSource="{Binding Prompts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PromptDisplayItem">
                        <Border Padding="0,2" Margin="0,2">
                            <Grid ColumnDefinitions="11,*,Auto,Auto,Auto">
                                <!-- Selection indicator -->
                                <Border Grid.Column="0"
                                        Width="3" Height="16" CornerRadius="1.5"
                                        Background="{DynamicResource SystemAccentColor}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsSelected}" />

                                <!-- Name (click to select) -->
                                <Button Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Padding="6,8"
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Tr Settings_Prompts_BuiltInBadge}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsBuiltIn}" />
                                    </StackPanel>
                                </Button>

                                <!-- Duplicate -->
                                <Button Grid.Column="2"
                                        Content="{loc:Tr Settings_Prompts_DuplicateButton}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DuplicateCommand}"
                                        CommandParameter="{Binding Id}" />

                                <!-- Edit (user prompts only) -->
                                <Button Grid.Column="3"
                                        Content="{loc:Tr Settings_Prompts_EditButton}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding EditCommand}"
                                        CommandParameter="{Binding Id}"
                                        IsVisible="{Binding CanEdit}" />

                                <!-- Delete (user prompts only) -->
                                <Button Grid.Column="4"
                                        Content="{loc:Tr Settings_Prompts_DeleteButton}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding Id}"
                                        IsVisible="{Binding CanEdit}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{loc:Tr Settings_Prompts_NewButton}"
                    Margin="0,8,0,0"
                    Command="{Binding NewPromptCommand}" />
        </StackPanel>

        <!-- Inline editor -->
        <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
            <TextBlock Text="{loc:Tr Settings_Prompts_NameLabel}" FontWeight="SemiBold" />
            <TextBox Text="{Binding EditingName}" PlaceholderText="{loc:Tr Settings_Prompts_NamePlaceholder}" />

            <TextBlock Text="{loc:Tr Settings_Prompts_TextLabel}" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBox Text="{Binding EditingText}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="120" />
            <StackPanel Spacing="2">
                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap">
                    <Run Text="{loc:Tr Settings_Prompts_Editor_PlaceholdersLabel}" />
                    <Run Text="{}{speech_lang}" FontWeight="SemiBold" />
                    <Run Text="{loc:Tr Settings_Prompts_Editor_SpeechLangHint}" />
                    <Run Text="{}{text_lang}" FontWeight="SemiBold" />
                    <Run Text="{loc:Tr Settings_Prompts_Editor_TextLangHint}" />
                </TextBlock>
                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Text="{loc:Tr Settings_Prompts_Editor_TranslationNote}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="{loc:Tr Settings_Prompts_SaveButton}"
                        Command="{Binding SavePromptCommand}" />
                <Button Content="{loc:Tr Common_Cancel}"
                        Command="{Binding CancelEditCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
