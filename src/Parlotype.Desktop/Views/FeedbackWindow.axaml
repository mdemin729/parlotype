<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Parlotype.Desktop.ViewModels"
        xmlns:loc="using:Parlotype.Desktop.Markup"
        x:Class="Parlotype.Desktop.Views.FeedbackWindow"
        x:DataType="vm:FeedbackViewModel"
        x:CompileBindings="True"
        Title="{loc:Tr Feedback_WindowTitle}"
        Width="560"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:FeedbackViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
    </Window.Styles>

    <Border Padding="20">
        <StackPanel Spacing="14">

            <TextBlock Text="{loc:Tr Feedback_Intro}" TextWrapping="Wrap" Opacity="0.8" />

            <!-- Kind -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Feedback_KindLabel}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton Name="FeedbackKindButton"
                                 GroupName="FeedbackKind"
                                 Content="{loc:Tr Feedback_Kind_Feedback}"
                                 AutomationProperties.Name="{loc:Tr Feedback_Kind_Feedback}"
                                 IsChecked="{Binding IsFeedback, Mode=TwoWay}" />
                    <RadioButton Name="BugKindButton"
                                 GroupName="FeedbackKind"
                                 Content="{loc:Tr Feedback_Kind_Bug}"
                                 AutomationProperties.Name="{loc:Tr Feedback_Kind_Bug}"
                                 IsChecked="{Binding IsBugReport, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Message -->
            <StackPanel Spacing="4">
                <Label Content="{loc:Tr Feedback_MessageLabel}"
                       Target="MessageBox"
                       Padding="0"
                       FontWeight="SemiBold" />
                <TextBox Name="MessageBox"
                         Text="{Binding Message, Mode=TwoWay}"
                         MaxLength="{Binding MessageMaxLength}"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         Height="170"
                         PlaceholderText="{loc:Tr Feedback_MessagePlaceholder}"
                         AutomationProperties.Name="{loc:Tr Feedback_MessageLabel}"
                         AutomationProperties.HelpText="{loc:Tr Feedback_MessagePlaceholder}" />
                <TextBlock Text="{Binding CharacterCountText}"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Opacity="0.6" />
            </StackPanel>

            <!-- Email -->
            <StackPanel Spacing="4">
                <Label Content="{loc:Tr Feedback_EmailLabel}"
                       Target="EmailBox"
                       Padding="0"
                       FontWeight="SemiBold" />
                <TextBox Name="EmailBox"
                         Text="{Binding Email, Mode=TwoWay}"
                         MaxLength="{Binding EmailMaxLength}"
                         Classes.invalid="{Binding IsEmailInvalid}"
                         PlaceholderText="{loc:Tr Feedback_EmailHint}"
                         AutomationProperties.Name="{loc:Tr Feedback_EmailLabel}"
                         AutomationProperties.HelpText="{loc:Tr Feedback_EmailHint}" />
                <TextBlock Name="EmailInvalidText"
                           Text="{loc:Tr Feedback_EmailInvalid}"
                           IsVisible="{Binding IsEmailInvalid}"
                           Classes="error"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- What will be sent -->
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="4" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Feedback_DetailsHeading}" FontWeight="SemiBold" />
                    <CheckBox Name="IncludeAppVersionBox"
                              Content="{Binding AppVersionLabel}"
                              AutomationProperties.Name="{Binding AppVersionLabel}"
                              IsChecked="{Binding IncludeAppVersion, Mode=TwoWay}" />
                    <CheckBox Name="IncludeOsBox"
                              Content="{Binding OperatingSystemLabel}"
                              AutomationProperties.Name="{Binding OperatingSystemLabel}"
                              IsChecked="{Binding IncludeOperatingSystem, Mode=TwoWay}" />
                    <CheckBox Name="IncludeUiLanguageBox"
                              Content="{Binding UiLanguageLabel}"
                              AutomationProperties.Name="{Binding UiLanguageLabel}"
                              IsChecked="{Binding IncludeUiLanguage, Mode=TwoWay}" />
                    <TextBlock Text="{loc:Tr Feedback_PrivacyNote}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Outcome of the last attempt -->
            <TextBlock Name="StatusTextBlock"
                       Text="{Binding StatusText}"
                       IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Classes.error="{Binding IsStatusError}"
                       TextWrapping="Wrap" />

            <StackPanel Name="FallbackPanel"
                        Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding ShowFallback}">
                <Button Name="WebsiteButton"
                        Content="{loc:Tr Feedback_Fallback_WebsiteButton}"
                        AutomationProperties.Name="{loc:Tr Feedback_Fallback_WebsiteButton}"
                        Command="{Binding SendFromWebsiteCommand}" />
                <Button Name="GitHubButton"
                        Content="{loc:Tr Feedback_Fallback_GitHubButton}"
                        AutomationProperties.Name="{loc:Tr Feedback_Fallback_GitHubButton}"
                        Command="{Binding OpenGitHubIssuesCommand}" />
            </StackPanel>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{loc:Tr Feedback_DraftNote}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.6"
                           Margin="0,0,12,0"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressBar IsIndeterminate="True"
                                 Width="60" Height="4"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsSending}" />
                    <Button Name="CloseButton"
                            Content="{loc:Tr Feedback_CloseButton}"
                            AutomationProperties.Name="{loc:Tr Feedback_CloseButton}"
                            Command="{Binding CloseCommand}"
                            MinWidth="90"
                            HorizontalContentAlignment="Center" />
                    <Button Name="SendButton"
                            Content="{loc:Tr Feedback_SendButton}"
                            AutomationProperties.Name="{loc:Tr Feedback_SendButton}"
                            Command="{Binding SendCommand}"
                            Classes="accent"
                            MinWidth="90"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
