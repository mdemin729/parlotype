<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Parlotype.Desktop.ViewModels"
        xmlns:views="using:Parlotype.Desktop.Views"
        xmlns:settingsViews="using:Parlotype.Desktop.Views.Settings"
        x:Class="Parlotype.Desktop.Views.TranscribeWindow"
        x:DataType="vm:TranscribeViewModel"
        x:CompileBindings="True"
        Title="Parlotype — Transcribe"
        Width="172" Height="118"
        CanResize="False"
        Topmost="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="WaveformActiveBrush" Color="White" />
        <SolidColorBrush x:Key="WaveformIdleBrush" Color="White" />
        <SolidColorBrush x:Key="WaveformDisabledBrush" Color="#378ADD" />
        <SolidColorBrush x:Key="WarnForegroundBrush" Color="#E0A23A" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.recording">
            <Setter Property="Background" Value="#378ADD" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Model is loading: same blue chrome as recording so the white spinner
             reads clearly, signalling "working" rather than an idle, dead button. -->
        <Style Selector="Button.loading">
            <Setter Property="Background" Value="#378ADD" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Quick-picker strip: miniature of the page relationship (spec §2.2). -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.stripConnector">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.stripConnector.on">
            <Setter Property="Background" Value="#378ADD" />
        </Style>
        <Style Selector="Button.stripConnector.on TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.stripConnector.off">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.stripConnector.locked">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="Button.windowClose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!-- ADR-032 transparency indicator: always visible while a cloud engine
             is active. Small footprint by design — the window is a fixed
             172x118 frameless card — with the full provider name in the tooltip. -->
        <Style Selector="Border.cloudBadge">
            <Setter Property="Background" Value="#378ADD" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:TranscribeViewModel />
    </Design.DataContext>

    <!-- Frameless chrome: the window itself is transparent; this border is the
         visible rounded card. Status lives in its tooltip only (plan C2). -->
    <Border Name="RootChrome"
            CornerRadius="12"
            BorderThickness="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            ToolTip.Tip="{Binding StatusText}">

        <Grid RowDefinitions="24,*,Auto" Margin="0,0,0,8">

            <!-- Header zone: the grip strip is the only drag handle (Windows
                 Voice Typing style); the ✕ hides the widget to the tray. -->
            <Border Name="GripZone"
                    Grid.Row="0"
                    Background="Transparent"
                    Cursor="SizeAll"
                    PointerPressed="GripZone_PointerPressed">
                <Border Width="40" Height="4"
                        CornerRadius="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            </Border>

            <!-- Cloud-active indicator (ADR-032 commitment #3): always visible while
                 a cloud engine is selected, naming the provider via tooltip since the
                 172px-wide frameless card has no room for the full label inline. -->
            <Border Name="CloudBadge"
                    Grid.Row="0"
                    Classes="cloudBadge"
                    IsVisible="{Binding IsCloudEngineActive}"
                    CornerRadius="7"
                    Padding="5,2"
                    Margin="6,3,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ToolTip.Tip="{Binding CloudProviderLabel}">
                <TextBlock Text="Cloud" FontSize="10" FontWeight="SemiBold" Foreground="White" />
            </Border>

            <Button Name="CloseButton"
                    Grid.Row="0"
                    Classes="windowClose"
                    Width="22" Height="22"
                    Margin="0,2,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="CloseButton_Click"
                    ToolTip.Tip="Hide window">
                <TextBlock Text="&#x2715;" FontSize="12" Opacity="0.7" />
            </Button>

            <Grid Grid.Row="1" ColumnDefinitions="*,6,44" Margin="8,0">
                <!-- Tooltip names the current push-to-talk gesture; the more
                     specific tip wins over RootChrome's status tooltip. -->
                <Button Name="RecordButton"
                        Grid.Column="0"
                        Classes.recording="{Binding IsRecording}"
                        Classes.loading="{Binding IsLoading}"
                        Command="{Binding TogglePlayCommand}"
                        ToolTip.Tip="{Binding HotkeyHintText}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CornerRadius="22"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0">
                    <Border>
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                            </Transitions>
                        </Border.Transitions>
                        <views:WaveformView
                            Width="64" Height="32"
                            State="{Binding RecordingState}"
                            AudioAmplitude="{Binding AudioLevel}"
                            ClipToBounds="False" />
                    </Border>
                </Button>

                <Button Name="SettingsButton"
                        Grid.Column="2"
                        Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CornerRadius="22"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0"
                        ToolTip.Tip="Settings">
                    <PathIcon Width="18" Height="18"
                              Data="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46a.5.5 0 0 0-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65A.488.488 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1a.566.566 0 0 0-.18-.03c-.17 0-.34.09-.43.25l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46a.5.5 0 0 0 .61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.06.02.12.03.18.03.17 0 .34-.09.43-.25l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5z" />
                </Button>
            </Grid>

            <!-- Quick-picker strip: source · connector · target (spec §2.2). -->
            <Border Name="LanguageStrip"
                    Grid.Row="2"
                    IsVisible="{Binding HasLanguageStrip}"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="9" Padding="2"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="chip"
                            Command="{Binding OpenLanguageFlyoutCommand}"
                            Content="{Binding SourceShort}" />
                    <Button Classes="stripConnector"
                            Classes.on="{Binding Relationship.IsConnectorOn}"
                            Classes.off="{Binding Relationship.IsConnectorOff}"
                            Classes.locked="{Binding Relationship.IsConnectorLocked}"
                            IsEnabled="{Binding !Relationship.IsConnectorLocked}"
                            Command="{Binding ToggleTranslationCommand}"
                            ToolTip.Tip="Toggle translation">
                        <TextBlock Text="{Binding Relationship.ConnectorGlyph}" FontSize="12" />
                    </Button>
                    <Button Classes="chip"
                            Command="{Binding OpenLanguageFlyoutCommand}"
                            Content="{Binding TargetShort}" />
                </StackPanel>
            </Border>

            <!-- Language flyout: opens above the widget, leads with the target
                 control, source is read-only and routes to Settings (spec §2.2). -->
            <Popup Grid.Row="2"
                   PlacementTarget="{Binding #LanguageStrip}"
                   Placement="TopEdgeAlignedLeft"
                   VerticalOffset="-8"
                   IsLightDismissEnabled="True"
                   IsOpen="{Binding IsLanguageFlyoutOpen, Mode=TwoWay}">
                <Border Classes="popoverChrome" Width="268">
                    <StackPanel Spacing="8">

                        <!-- Toggle form: labelled switch. -->
                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding Relationship.IsToggleForm}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Relationship.ToggleSwitchLabel}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding Relationship.TranslationSwitch, Mode=TwoWay}"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <!-- None form: short amber explanation. -->
                        <TextBlock IsVisible="{Binding Relationship.IsNoneForm}"
                                   Text="{Binding Relationship.UnavailableNote}"
                                   Foreground="{DynamicResource WarnForegroundBrush}"
                                   FontSize="12" TextWrapping="Wrap" />

                        <!-- Full form: the shared picker (header, search, Off row, list).
                             IsVisible lives on the wrapper — the picker's DataContext is
                             swapped to the picker VM, which has no Relationship. -->
                        <Panel IsVisible="{Binding Relationship.IsFullForm}">
                            <settingsViews:LanguagePickerView
                                DataContext="{Binding TargetPicker}"
                                MaxHeight="280" />
                        </Panel>

                        <Separator Opacity="0.4" />

                        <!-- Read-only source row: editing the source lives in Settings. -->
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                Padding="8,6" CornerRadius="8"
                                Command="{Binding GoToLanguageSettingsCommand}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="You speak" FontSize="11" Opacity="0.55" />
                                    <TextBlock Text="{Binding Relationship.SourceDisplayLabel}"
                                               FontSize="13" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="Settings →"
                                           FontSize="11" Opacity="0.55"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
