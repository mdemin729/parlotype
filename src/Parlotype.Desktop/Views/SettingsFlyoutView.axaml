<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             xmlns:v="using:Parlotype.Desktop.Views"
             x:Class="Parlotype.Desktop.Views.SettingsFlyoutView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True"
             Width="340">

    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            Padding="0">
        <StackPanel>

            <!-- Select default microphone -->
            <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16,10" CornerRadius="0">
                <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop" ShowMode="Transient">
                        <Flyout.FlyoutPresenterTheme>
                            <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                            </ControlTheme>
                        </Flyout.FlyoutPresenterTheme>
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                Padding="4" MinWidth="280">
                            <v:MicrophoneSettingsView DataContext="{Binding}" />
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Data="M12 2a3.5 3.5 0 0 1 3.5 3.5v5a3.5 3.5 0 0 1-7 0v-5A3.5 3.5 0 0 1 12 2Zm0 1.5a2 2 0 0 0-2 2v5a2 2 0 0 0 4 0v-5a2 2 0 0 0-2-2ZM6.25 9a.75.75 0 0 1 .75.75v.75a5 5 0 0 0 10 0v-.75a.75.75 0 0 1 1.5 0v.75a6.5 6.5 0 0 1-5.75 6.45v2.3a.75.75 0 0 1-1.5 0v-2.3A6.5 6.5 0 0 1 5.5 10.5v-.75a.75.75 0 0 1 .75-.75Z" />
                    <TextBlock Grid.Column="1" Text="Select default microphone"
                               VerticalAlignment="Center" FontSize="14" />
                    <TextBlock Grid.Column="2" Text="›" FontSize="18"
                               VerticalAlignment="Center" Opacity="0.5" />
                </Grid>
            </Button>

            <Separator Margin="16,0" />

            <!-- Select Whisper model -->
            <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16,10" CornerRadius="0"
                    Name="ModelPickerButton">
                <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop" ShowMode="Transient">
                        <Flyout.FlyoutPresenterTheme>
                            <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                            </ControlTheme>
                        </Flyout.FlyoutPresenterTheme>
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                Padding="4" MinWidth="260">
                            <ItemsControl ItemsSource="{Binding ModelOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WhisperModelDisplayItem">
                                        <Button Background="Transparent"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="12,8" CornerRadius="4"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding Type}">
                                            <Grid ColumnDefinitions="11,*,Auto,Auto">
                                                <Grid Grid.Column="0" Width="11" VerticalAlignment="Center">
                                                    <Border Width="3" Height="16"
                                                            CornerRadius="1.5"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource SystemAccentColor}"
                                                            IsVisible="{Binding IsSelected}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DiskSize}"
                                                           FontSize="13" Opacity="0.5"
                                                           VerticalAlignment="Center"
                                                           Margin="24,0,0,0" />
                                                <PathIcon Grid.Column="3"
                                                         Width="12" Height="12" Opacity="0.5"
                                                         VerticalAlignment="Center"
                                                         Margin="6,0,0,0"
                                                         IsVisible="{Binding !IsCached}"
                                                         Data="M13 3C13 2.44772 12.5523 2 12 2C11.4477 2 11 2.44772 11 3V15.0858L7.70711 11.7929C7.31658 11.4024 6.68342 11.4024 6.29289 11.7929C5.90237 12.1834 5.90237 12.8166 6.29289 13.2071L11.2929 18.2071C11.6834 18.5976 12.3166 18.5976 12.7071 18.2071L17.7071 13.2071C18.0976 12.8166 18.0976 12.1834 17.7071 11.7929C17.3166 11.4024 16.6834 11.4024 16.2929 11.7929L13 15.0858V3ZM5 20C4.44772 20 4 20.4477 4 21C4 21.5523 4.44772 22 5 22H19C19.5523 22 20 21.5523 20 21C20 20.4477 19.5523 20 19 20H5Z" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 2c2.87 0 5.39 1.52 6.8 3.8L13.5 11H19c.06.33.1.66.1 1 0 3.87-2.73 7.1-6.36 7.86L15 14.5l-4.5 2.6L8 14l-4.12 2.38A7.964 7.964 0 0 1 4 12c0-4.42 3.58-8 8-8Z" />
                    <TextBlock Grid.Column="1" Text="Whisper model"
                               VerticalAlignment="Center" FontSize="14" />
                    <TextBlock Grid.Column="2" Text="›" FontSize="18"
                               VerticalAlignment="Center" Opacity="0.5" />
                </Grid>
            </Button>

            <Separator Margin="16,0" />

            <!-- Theme -->
            <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16,10" CornerRadius="0">
                <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop" ShowMode="Transient">
                        <Flyout.FlyoutPresenterTheme>
                            <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                            </ControlTheme>
                        </Flyout.FlyoutPresenterTheme>
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                Padding="4" MinWidth="200">
                            <ItemsControl ItemsSource="{Binding ThemeOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeDisplayItem">
                                        <Button Background="Transparent"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="12,8" CornerRadius="4"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding Theme}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 1.5V12l-6.5 6.5A8.5 8.5 0 0 1 12 3.5Z" />
                    <TextBlock Grid.Column="1" Text="Theme"
                               VerticalAlignment="Center" FontSize="14" />
                    <TextBlock Grid.Column="2" Text="›" FontSize="18"
                               VerticalAlignment="Center" Opacity="0.5" />
                </Grid>
            </Button>

            <!-- Footer -->
            <TextBlock Text="Powered by Whisper"
                       FontSize="11" Opacity="0.4"
                       HorizontalAlignment="Center"
                       Margin="16,0,16,12" />

        </StackPanel>
    </Border>
</UserControl>
