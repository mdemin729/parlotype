<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Parlotype.Desktop.ViewModels"
             x:Class="Parlotype.Desktop.App"
             x:DataType="vm:AppViewModel">
    <Application.Styles>
        <FluentTheme />

        <!-- Shared chrome for the language picker popovers (Settings page popups
             and the Transcribe window flyout host their own width). -->
        <Style Selector="Border.popoverChrome">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/parlotype.ico"
                      ToolTipText="Parlotype"
                      Command="{Binding TrayIconClickedCommand}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <NativeMenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
