<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- BenchmarkDotNet is only meaningful in Release; the project still has to
         compile in Debug so `dotnet build Parlotype.slnx` stays green. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parlotype.Core\Parlotype.Core.csproj" />
    <ProjectReference Include="..\Parlotype.Platform\Parlotype.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
