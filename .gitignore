## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates

# Rider
.idea/

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Whisper model files
*.bin

# Avalonia designer cache
*.axaml.cache

# Test results
TestResults/

# Cached WAV files converted from FLAC
datasets/**/.cache/*.wav

# Benchmark results
results/*

# Committed benchmark artefacts — keep in lock-step with the comparison reports
# that reference them. Add a new `!` line whenever a report is committed.
!results/comparison-libri-speech-test-other-2026-05-23-cuda.md
!results/20260523-200406-whisper-small-libri-speech-test-other.json
!results/20260523-200421-whisper-medium-libri-speech-test-other.json
!results/20260523-200446-whisper-large-v3-turbo-libri-speech-test-other.json
!results/20260523-204306-whisper-small-libri-speech-test-other.json
!results/20260523-204332-whisper-medium-libri-speech-test-other.json
!results/20260523-204406-whisper-large-v3-turbo-libri-speech-test-other.json
!results/20260523-200528-gemma4-e2b-bf16-libri-speech-test-other.json
!results/20260523-200549-gemma4-e4b-q4-libri-speech-test-other.json
!results/20260523-200611-gemma4-e4b-q8-libri-speech-test-other.json
!results/20260523-200638-gemma4-e4b-bf16-libri-speech-test-other.json
!results/20260523-201057-gemma4-e2b-q8-libri-speech-test-other.json


# Generated test reports
reports/

# BenchmarkDotNet output (src/Parlotype.MicroBenchmarks)
BenchmarkDotNet.Artifacts/

# Velopack packaging (ADR-053)
publish/
publish-*/
Releases/
Releases-*/
.vpk/

# Scratch output of the release workflow's "Extract release notes" step (ADR-054).
# CHANGELOG.md is the source of truth; this is the slice cut out of it for one tag,
# written in CI and by anyone running the gate locally.
release-notes.md

# Signing material — never commit these. Belt and braces: signing is not wired
# up yet, so these rules exist to make an accidental `git add` fail loudly
# rather than leak a certificate.
*.pfx
*.p12
*.snk
*.cer
*.crt
*.key
*.mobileprovision
*.provisionprofile
# Azure Trusted Signing config passed to `vpk pack --azureTrustedSignFile`.
# Named specifically rather than ignoring every metadata.json in the tree.
azure-trusted-signing.json

# Generated benchmark audio (regenerate with datasets/build-long-audio-ladder.py)
datasets/long-audio-ladder/samples/
datasets/long-audio-probe/samples/
datasets/__pycache__/
