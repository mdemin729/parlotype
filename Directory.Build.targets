<Project>

  <!--
    Drop the ONNX Runtime GPU execution providers from build and publish output.

    SileroVad 1.3.0 depends on Microsoft.ML.OnnxRuntime.Gpu, which drags in the CUDA and
    TensorRT execution providers — onnxruntime_providers_cuda.dll alone is 391 MB, over
    half of a self-contained win-x64 publish. Nothing in Parlotype ever registers them:
    Silero VAD constructs `new Vad()` with default (CPU) session options, and Parakeet
    pins `Provider = "cpu"` (ADR-041). They are also built against ONNX Runtime 1.18.1,
    while the onnxruntime.dll that actually lands in the output folder comes from
    sherpa-onnx's own newer native package — so they could not load even if asked.

    Only the provider libraries go. onnxruntime.dll, onnxruntime_providers_shared.dll and
    the managed Microsoft.ML.OnnxRuntime.dll stay — the first two are required for any
    inference at all, GPU or not. The Contains() match also covers the lib*.so/.dylib
    spellings and the accompanying .lib import libraries.

    See ADR-050.
  -->
  <Target Name="RemoveUnusedOnnxRuntimeProvidersFromBuild"
          AfterTargets="ResolveReferences">
    <ItemGroup>
      <_UnusedOnnxRuntimeProviderCopyLocal Include="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_cuda'))
                     or $([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_tensorrt'))" />
      <ReferenceCopyLocalPaths Remove="@(_UnusedOnnxRuntimeProviderCopyLocal)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveUnusedOnnxRuntimeProvidersFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_UnusedOnnxRuntimeProviderToPublish Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_cuda'))
                     or $([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_tensorrt'))" />
      <ResolvedFileToPublish Remove="@(_UnusedOnnxRuntimeProviderToPublish)" />
    </ItemGroup>
  </Target>

</Project>
