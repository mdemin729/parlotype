<Project>

  <!--
    Drop the ONNX Runtime GPU execution providers from build and publish output.

    SileroVad 1.3.0 depends on Microsoft.ML.OnnxRuntime.Gpu, which drags in the CUDA and
    TensorRT execution providers — onnxruntime_providers_cuda.dll alone is 391 MB, over
    half of a self-contained win-x64 publish. Nothing in Parlotype ever registers them:
    Silero VAD constructs `new Vad()` with default (CPU) session options, and Parakeet
    pins `Provider = "cpu"` (ADR-041). They are also built against ONNX Runtime 1.18.1,
    while the onnxruntime.dll that actually lands in the output folder comes from
    sherpa-onnx's own newer native package — so they could not load even if asked.

    Only the provider libraries go. onnxruntime.dll, onnxruntime_providers_shared.dll and
    the managed Microsoft.ML.OnnxRuntime.dll stay — the first two are required for any
    inference at all, GPU or not. The Contains() match also covers the lib*.so/.dylib
    spellings and the accompanying .lib import libraries.

    See ADR-050.
  -->
  <Target Name="RemoveUnusedOnnxRuntimeProvidersFromBuild"
          AfterTargets="ResolveReferences">
    <ItemGroup>
      <_UnusedOnnxRuntimeProviderCopyLocal Include="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_cuda'))
                     or $([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_tensorrt'))" />
      <ReferenceCopyLocalPaths Remove="@(_UnusedOnnxRuntimeProviderCopyLocal)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveUnusedOnnxRuntimeProvidersFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_UnusedOnnxRuntimeProviderToPublish Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_cuda'))
                     or $([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_tensorrt'))" />
      <ResolvedFileToPublish Remove="@(_UnusedOnnxRuntimeProviderToPublish)" />
    </ItemGroup>
  </Target>

  <!--
    Drop the Whisper.net native libraries built for platforms we are not publishing for.

    Whisper.net.Runtime and Whisper.net.Runtime.Vulkan do not use the runtimes/<rid>/native
    convention, so the SDK's RID filtering never sees them: their .targets declare plain
    <None> content items with a hard-coded TargetPath (runtimes/win-x64/whisper.dll,
    runtimes/vulkan/linux-x64/libggml-vulkan-whisper.so, …). What gating they do have is on
    TargetFramework, not RuntimeIdentifier — and `net10.0` has no platform suffix, so the
    Windows *and* macOS blocks both fire while the Linux ones are unconditional. A win-x64
    publish therefore carries every desktop platform: ~60 MB, 45 of it the Linux twin of
    ggml-vulkan-whisper.dll.

    In both layouts the RID is the immediate parent directory of the file, which is what the
    match below keys on — so runtimes/vulkan/win-x64/ survives alongside runtimes/win-x64/.
    Restricting it to a known RID list (rather than "anything that isn't our RID") keeps the
    filter from touching runtimes/ paths owned by any other package.

    Publish only: `bin/` output is left exactly as it was, so dev builds and tests are
    unaffected. See ADR-051.
  -->
  <PropertyGroup>
    <!-- Every RID directory the two Whisper.net runtime packages can emit, semicolon-delimited. -->
    <WhisperRuntimeRidDirectories>;linux-arm;linux-arm64;linux-x64;macos-arm64;macos-x64;win-arm64;win-x64;win-x86;</WhisperRuntimeRidDirectories>
  </PropertyGroup>

  <Target Name="RemoveForeignRuntimeAssetsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_ForeignWhisperRuntimeRids>$(WhisperRuntimeRidDirectories.Replace(';$(RuntimeIdentifier);', ';'))</_ForeignWhisperRuntimeRids>
    </PropertyGroup>
    <ItemGroup>
      <_ForeignRuntimeAssetToPublish Include="@(ResolvedFileToPublish)"
          Condition="$(_ForeignWhisperRuntimeRids.Contains(';$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(RelativePath)'))));'))" />
      <ResolvedFileToPublish Remove="@(_ForeignRuntimeAssetToPublish)" />
    </ItemGroup>
  </Target>

  <!--
    Drop native .pdb symbol files from Release publish output.

    Avalonia's Skia rendering backend pulls in SkiaSharp.NativeAssets.Win32 and
    HarfBuzzSharp.NativeAssets.Win32, whose runtimes/win-x64/native/ payloads include
    libSkiaSharp.pdb (~80 MB) and libHarfBuzzSharp.pdb (~20 MB) alongside the native DLLs —
    together nearly 100 MB, the two largest files in the publish output after ADR-050/051.
    Nobody debugs into Skia's or HarfBuzz's native code from a Parlotype crash; these symbols
    are dead weight in a shipped build.

    NuGet tags these as %(AssetType) == 'native', which is what the filter keys on rather
    than filename — it also cleanly excludes Parlotype's own managed PDBs (Parlotype.Desktop/
    Platform/Core.pdb), which carry no AssetType at all and are worth keeping for crash
    symbolication.

    Release/publish only: a `dotnet publish -c Debug` keeps every symbol, and `bin/` dev
    output is untouched either way. See ADR-052.
  -->
  <Target Name="RemoveNativePdbsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_NativePdbToPublish Include="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.pdb' and '%(ResolvedFileToPublish.AssetType)' == 'native'" />
      <ResolvedFileToPublish Remove="@(_NativePdbToPublish)" />
    </ItemGroup>
  </Target>

</Project>
